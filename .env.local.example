# --- Local development defaults (copy to .env.local) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api
NEXT_PUBLIC_AI_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_GEOAPIFY_API_KEY=your_geoapify_api_key_here
NEXT_PUBLIC_USE_MOCKS=true

# --- Vercel production environment variables ---
# The Next.js frontend and FastAPI backend ship as ONE Vercel project, so the
# browser must call the backend same-origin via the vercel.json rewrites
# (/api/*, /outputs/*, /docs, /openapi.json -> the "backend" service).
# In production:
#   - Leave NEXT_PUBLIC_AI_API_URL UNSET (api.ts falls back to same-origin "").
#   - Set NEXT_PUBLIC_API_BASE_URL to "/api" (NOT http://localhost:3001/api).
#   - Leave NEXT_PUBLIC_WS_URL UNSET: Vercel rewrites/Functions do not proxy
#     WebSockets, and localhost:3001 does not exist in production.
#   - Set NEXT_PUBLIC_USE_MOCKS to "false" only when pointing the app at the
#     real API; the deterministic mock layer works without a backend.
